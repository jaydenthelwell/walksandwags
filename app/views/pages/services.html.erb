<% content_for :title, "Our Dog Walking Services | Walks & Wags Co." %>
<% content_for :meta_description, "Explore our dog walking and sitting services in East London. Solo, group, duo walks, back-to-back sessions, overnight care, and drop-ins tailored to every pup." %>

<div class="services-container">
  <%= render 'shared/navbar' %>

  <section id="section3" class="color-bg" style="background-color: #E8AFC7;">
    <div class="prices-div">
      <div class="d-flex justify-content-center flex-column align-items-center">
        <h1 class="wanstead-wags-title titles prices text-center" style="color: #032B22;">Choose the Pawfect Service</h1>
        <p class="price-list text-center" style="font-family: Lato, serif, sans-serif !important;">
          Choosing the right service for your dog can be tricky, but we’re here to help! Read the descriptions below to find the best option for your furry friend.
        </p>
      </div>

      <% services = [
        # Walks
        { title: "1-Hour Group Dog Walks", price: "£17.50", description: "A fun and social experience for dogs who love companionship!", bullets: ["Small, Well-Matched Groups: Your dog will join a pack of 3-4 friendly, compatible dogs.", "Exciting Outdoor Adventures: Walks take place in parks, fields, and woodlands.", "Physical & Mental Stimulation: Group walks encourage social interaction, improve confidence, and reinforce good manners.", "Safe & Supervised: Experienced dog walkers ensure structured, enjoyable walks.", "Perfect for Social Dogs: Ideal for pups who thrive in a pack environment."] },
        { title: "1-Hour Solo Dog Walks", price: "£25", description: "A peaceful, one-on-one walking experience tailored to your dog's unique needs.", bullets: ["Gentle & Relaxing: A quiet, stress-free walk through woodlands, fields, or lakes.", "Ideal for Anxious or Nervous Dogs: Comfortable and safe space.", "Perfect for Reactive Dogs: Controlled environment.", "Tailored to Health Needs: Suitable for older dogs or dogs recovering from injury.", "Personalised Attention: Walk adapted to your dog's pace, interests, and personality."] },
        { title: "30-Minute Solo Dog Walks", price: "£15", description: "A short, focused walk for pups who need a quick burst of exercise.", bullets: ["Quick & Energising: Perfect for busy schedules or young puppies.", "Solo Attention: One-on-one care ensures personalised pacing.", "Mental Stimulation: Includes enrichment activities during the walk."] },
        { title: "B2B Group Walks (2 Back-to-Back)", price: "£30", description: "Double the fun for social pups who want extra adventure!", bullets: ["Two Group Walks in a row: Extended socialisation and exercise.", "Small, compatible packs for safe interaction.", "Varied routes for mental and physical stimulation."] },
        # Duo / Two dogs same household
        { title: "1-Hour Group Walks – Two Dogs Same Household", price: "£30", description: "Bring both dogs from the same household for a group adventure!", bullets: ["Small group, twice the fun.", "Cost-effective for households with multiple dogs.", "Socialisation & exercise tailored for pairs."] },
        { title: "1-Hour Solo Walks – Two Dogs Same Household", price: "£40", description: "A private, one-on-one walk for both dogs from the same home.", bullets: ["Personalised pacing for each dog.", "Peaceful environment, minimal distractions.", "Great for bonding between the pair."] },
        { title: "30-Minute Solo Walks – Two Dogs Same Household", price: "£25", description: "Quick private walk for two dogs together.", bullets: ["Perfect for busy days.", "Individual attention while together.", "Mental stimulation included."] },
        # Overnight / Sitting
        { title: "Overnight Dog Sitting", price: "1 dog – £50 / 2 dogs same house – £75 / 2 dogs with midday walk – £90", description: "A cosy overnight care service so your dog feels safe, loved, and comfortable in their own home.", bullets: ["Evening & Morning Walks Included", "Familiar Environment: Dogs remain in the comfort of their own home.", "Tailored to Routine: Feeding times, medication, and bedtime habits followed carefully.", "Updates & Photos: For peace of mind while you're away.", "Daytime walks are optional and should be booked separately."] },
        { 
          title: "30-Minute Drop-In", 
          price: "£15", 
          description: "A quick daytime visit to check on your dog, provide meals, and give some company.", 
          bullets: [
            "Quick midday visit for meals and companionship.", 
            "Ensures your dog is happy and comfortable during the day.", 
            "Personalised routine followed carefully.", 
            "Peace of mind with updates and photos."
          ] 
        },
        { 
          title: "2-Hour Evening Sit", 
          price: "£30", 
          description: "Extended evening care to ensure your dog feels safe and loved while you’re away.", 
          bullets: [
            "Evening care and supervision.", 
            "Tailored attention to feeding, play, and settling in for the night.", 
            "Familiar environment for comfort.", 
            "Updates and photos for peace of mind."
          ] 
        }
      ] %>

      <div class="services mt-0 gap-5">
        <% services.each do |service| %>
          <div class="d-flex align-items-center services-flex">
            <div class="d-flex flex-column align-items-center services-paragraph services-div">
              <h1 class="font-Abril text service services-description service-name"><%= service[:title] %> <% if service[:price] %>~ <%= service[:price] %><% end %></h1>
              <p class="text service services-description services-font services-text"><%= service[:description] %></p>
              <ul class="text service services-description services-font services-text">
                <% service[:bullets].each do |bullet| %>
                  <li><%= bullet %></li>
                <% end %>
              </ul>
              <%= link_to("ENQUIRE NOW", new_contact_form_path, class: "mt-3 text-center button") %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</div>